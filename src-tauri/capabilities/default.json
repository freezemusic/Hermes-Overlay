{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main overlay window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "opener:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-probe-gateway",
    "allow-discover-profiles",
    "allow-open-bot",
    "allow-send-chat",
    "allow-stop-chat"
  ]
}
