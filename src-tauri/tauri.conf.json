{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Overlay",
  "version": "0.1.0",
  "identifier": "com.freezemusic.hermes-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hermes Overlay",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "maximized": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Always-on-top overlay for a Hermes gateway",
    "longDescription": "A transparent, always-on-top desktop overlay for chatting with bots on a self-hosted Hermes Agent gateway. Set the gateway URL and an API key in Settings. On Linux, API keys use Secret Service and links open through xdg-utils.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "recommends": ["gnome-keyring", "xdg-utils"]
      },
      "rpm": {
        "recommends": ["gnome-keyring", "xdg-utils"]
      }
    }
  }
}
